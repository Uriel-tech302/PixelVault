meta {
  name: 16 Editar entrada (PUT)
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/api/biblioteca/{{itemId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

body:json {
  {
    "estado": "COMPLETADO",
    "horasJugadas": 48.2,
    "ultimaSesion": "2026-11-20",
    "puntuacion": 5
  }
}

assert {
  res.status: eq 200
}

tests {
  test("refleja los cambios", function () {
    expect(res.body.estado).to.equal("COMPLETADO");
    expect(res.body.horasJugadas).to.equal(48.2);
    expect(res.body.ultimaSesion).to.equal("2026-11-20");
    expect(res.body.puntuacion).to.equal(5);
  });
}
