meta {
  name: 15 Resumen de biblioteca
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/biblioteca/resumen
  body: none
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("estadisticas del encabezado", function () {
    expect(res.body.totalJuegos).to.be.at.least(1);
    expect(res.body.horasTotales).to.be.at.least(12.5);
    expect(res.body.porcentajeCompletado).to.be.within(0, 100);
    expect(res.body.porEstado).to.have.all.keys("JUGANDO", "COMPLETADO", "ABANDONADO");
  });
}
