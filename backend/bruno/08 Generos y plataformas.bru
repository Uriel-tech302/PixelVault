meta {
  name: 08 Generos y plataformas (guarda plataformaId)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/plataformas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

vars:post-response {
  plataformaId: res.body[0].id
}

assert {
  res.status: eq 200
}

tests {
  test("lista de plataformas con id y nombre", function () {
    expect(res.body).to.be.an("array").that.is.not.empty;
    expect(res.body[0]).to.have.all.keys("id", "nombre");
  });
}
