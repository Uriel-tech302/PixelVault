meta {
  name: Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@pixelvault.com",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.token);
}

tests {
  test("Responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("Devuelve token JWT y rol ADMIN", function () {
    expect(res.body.token).to.be.a("string");
    expect(res.body.usuario.rol).to.equal("ADMIN");
  });
}
