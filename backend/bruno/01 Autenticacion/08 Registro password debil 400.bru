meta {
  name: Registro password debil 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "debil{{nuevoUser}}",
    "email": "debil{{nuevoUser}}@example.com",
    "password": "abc"
  }
}

tests {
  test("Responde 400", function () {
    expect(res.status).to.equal(400);
  });
  test("Incluye errores por campo", function () {
    expect(res.body.errores).to.have.property("password");
  });
}
