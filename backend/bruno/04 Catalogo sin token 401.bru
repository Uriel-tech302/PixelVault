meta {
  name: 04 Catalogo sin token (401)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/juegos
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

tests {
  test("formato de error JSON", function () {
    expect(res.body.status).to.equal(401);
    expect(res.body.mensaje).to.be.a("string");
  });
}
