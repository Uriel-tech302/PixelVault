meta {
  name: 14 Listar biblioteca (filtro estado, paginado)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/biblioteca?estado=JUGANDO&page=0&size=10&sort=horasJugadas,desc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("solo entradas JUGANDO y la nueva esta incluida", function () {
    expect(res.body.totalElementos).to.be.at.least(1);
    res.body.contenido.forEach(i => expect(i.estado).to.equal("JUGANDO"));
    expect(res.body.contenido.map(i => i.id)).to.include(Number(bru.getVar("itemId")));
  });
  test("la lista no trae la reseña completa", function () {
    res.body.contenido.forEach(i => expect(i).to.not.have.property("resena"));
  });
}
