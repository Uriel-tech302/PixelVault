meta {
  name: Agregar a biblioteca 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/biblioteca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

body:json {
  {
    "juegoId": {{juegoNuevoId}},
    "plataformaId": {{plataformaId}},
    "estado": "JUGANDO",
    "horasJugadas": 0
  }
}

script:post-response {
  bru.setVar("itemId", res.body.id);
}

tests {
  test("Responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
