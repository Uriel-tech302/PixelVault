}

body:json {
  {
    "juegoId": {{juegoNuevoId}},
    "plataformaId": {{plataformaId}},
    "estado": "JUGANDO",
    "horasJugadas": 0
  }
}

tests {
  test("Responde 409", function () {
    expect(res.status).to.equal(409);
  });
}
