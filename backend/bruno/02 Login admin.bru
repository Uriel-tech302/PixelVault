meta {
  name: 02 Login admin (guarda adminToken)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@pixelvault.com",
    "password": "{{adminPassword}}"
  }
}

vars:post-response {
  adminToken: res.body.token
}

assert {
  res.status: eq 200
}
