meta {
  name: 10 Agregar a la biblioteca (201, guarda itemId)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/biblioteca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

body:json {
  {
    "juegoId": {{juegoId}},
    "plataformaId": {{plataformaId}},
    "estado": "JUGANDO",
    "horasJugadas": 12.5,
    "puntuacion": 4
  }
}

vars:post-response {
  itemId: res.body.id
}

assert {
  res.status: eq 201
}

tests {
  test("devuelve la entrada con los campos que usa el frontend", function () {
    expect(res.body).to.include.keys("id", "juegoId", "titulo", "generos", "portadaUrl", "plataforma", "estado", "horasJugadas", "puntuacion", "tieneResena");
    expect(res.body.horasJugadas).to.equal(12.5);
    expect(res.body.puntuacion).to.equal(4);
    expect(res.body.tieneResena).to.equal(false);
  });
}

docs {
  Si la prueba se repite sin borrar la entrada, responde 409 (ya esta en la biblioteca). La peticion 21 la borra al final.
}
