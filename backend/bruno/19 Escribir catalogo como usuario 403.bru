meta {
  name: 19 Escribir catalogo como USUARIO (403)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/juegos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

body:json {
  {
    "titulo": "Juego de prueba"
  }
}

assert {
  res.status: eq 403
}

tests {
  test("formato de error JSON", function () {
    expect(res.body.status).to.equal(403);
  });
}
