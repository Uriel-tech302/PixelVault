meta {
  name: Plataformas 200
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/plataformas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

script:post-response {
  const a = Array.isArray(res.body) ? res.body : (res.body.contenido || []);
  if (a.length) { bru.setVar("plataformaId", a[0].id); }
}

tests {
  test("Responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
