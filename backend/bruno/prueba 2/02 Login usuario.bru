meta {
  name: Login usuario (guarda usuarioToken)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "usuario@pixelvault.com",
    "password": "{{usuarioPassword}}"
  }
}

vars:post-response {
  usuarioToken: res.body.token
}

assert {
  res.status: eq 200
}
