meta {
  name: Editar juego inexistente (404)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/juegos/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "titulo": "No existe",
    "generoIds": [{{generoId}}]
  }
}

assert {
  res.status: eq 404
}
