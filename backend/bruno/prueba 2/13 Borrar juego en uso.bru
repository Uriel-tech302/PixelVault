meta {
  name: Borrar juego en uso (409)
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/api/juegos/{{juegoNuevoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 409
}

tests {
  test("mensaje claro", function () {
    expect(res.body.mensaje).to.include("biblioteca");
  });
}
