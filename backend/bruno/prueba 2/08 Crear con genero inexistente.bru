meta {
  name: Crear con genero inexistente (422)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/juegos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "titulo": "Otro juego",
    "generoIds": [999999]
  }
}

assert {
  res.status: eq 422
}

tests {
  test("senala el campo", function () {
    expect(res.body.errores).to.have.property("generoIds");
  });
}
