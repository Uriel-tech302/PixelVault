meta {
  name: Crear con datos invalidos (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/juegos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "titulo": "",
    "anioLanzamiento": 1800,
    "portadaUrl": "ftp://ejemplo.com/x.jpg",
    "generoIds": []
  }
}

assert {
  res.status: eq 400
}

tests {
  test("un mensaje por campo", function () {
    expect(res.body.errores).to.include.keys("titulo", "anioLanzamiento", "portadaUrl", "generoIds");
  });
}
