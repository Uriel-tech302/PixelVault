meta {
  name: 05 Listar juegos (paginado, guarda juegoId)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/juegos?page=0&size=5&sort=titulo,asc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{usuarioToken}}
}

vars:post-response {
  juegoId: res.body.contenido[0].id
}

assert {
  res.status: eq 200
}

tests {
  test("trae una pagina de 5 y el total real", function () {
    expect(res.body.contenido).to.have.lengthOf(5);
    expect(res.body.tamanio).to.equal(5);
    expect(res.body.totalElementos).to.be.at.least(15);
    expect(res.body.totalPaginas).to.equal(Math.ceil(res.body.totalElementos / 5));
  });
  test("cada juego trae generos como lista y bannerUrl", function () {
    const j = res.body.contenido[0];
    expect(j.generos).to.be.an("array");
    expect(j).to.have.property("portadaUrl");
    expect(j).to.have.property("bannerUrl");
  });
  test("viene ordenado por titulo ascendente", function () {
    const t = res.body.contenido.map(j => j.titulo);
    expect(t).to.eql([...t].sort((a, b) => a.localeCompare(b)));
  });
}
