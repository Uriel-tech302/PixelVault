meta {
  name: Editar juego 200
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/juegos/{{juegoNuevoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "titulo": "Juego Bruno editado",
    "descripcion": "Creado por la coleccion de pruebas.",
    "anioLanzamiento": 2024,
    "desarrollador": "Equipo Bruno",
    "portadaUrl": "https://example.com/portada.jpg",
    "generoIds": [
      {{generoId}}
    ]
  }
}

tests {
  test("Responde 200", function () {
    expect(res.status).to.equal(200);
  });
  test("Titulo actualizado", function () {
    expect(res.body.titulo).to.equal("Juego Bruno editado");
  });
}
